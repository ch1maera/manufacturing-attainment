node_modules/
.venv/
# CUSTOMER-RELEASE BRANCH: dist/, client/dist/, and drizzle/ are intentionally
# COMMITTED on this branch (see the exceptions below) — there is no local
# build step in the customer package, so the pre-built server/client bundles
# and Drizzle migrations must already be on disk for `bundle deploy` to sync
# them (still whitelisted via sync.include in databricks.yml too, for
# defense-in-depth against a future re-ignore). Rebuild + re-commit them
# with `npm ci && npm run db:generate && npm run build:source` before
# cutting a new customer release.
.env
.env.local
.env.*
!.env.example
!.env.template
.DS_Store
*.tsbuildinfo
playwright-report/
test-results/

# Per-project Databricks auth file written by the Demo Prompt Generator
# at runtime (deployed mode). Contains a user PAT — never commit or
# ship with a template snapshot. See backend/AUTH.md in the generator.
.databrickscfg

# AppKit 0.41 typegen output (generated; regenerated on dev machine with warehouse access)
shared/appkit-types/

# Runtime PID file written by start.sh (preview process group) — never commit.
.preview.pgid

# NOTE: on `main`, dist/, client/dist/, and drizzle/ are gitignored build
# artifacts (see databricks.yml's `artifacts.default.build` + sync.include).
# On THIS branch they are deliberately NOT ignored (see the note above) —
# don't re-add `dist/`, `client/dist/`, or `drizzle/` patterns here.
