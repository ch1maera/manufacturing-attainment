# Skip lifecycle scripts during `npm install` on the Databricks Apps
# container. Postinstall is `npm run typegen` (calls `appkit
# generate-types`) which needs source-build context the runtime
# container doesn't have.
ignore-scripts=true

# Production-only install on the App container — only runtime deps are
# needed because dist/server.js and client/dist/ ship pre-built in this
# package (no build step on the App container or on the customer's machine).
# Locally, `npm install --include=dev` overrides this so the build
# tooling (tsdown, vite, etc.) is available if you rebuild from source.
omit=dev

# NOTE: registry override intentionally NOT set here — this package's
# package-lock.json already resolves against the public npm registry
# (registry.npmjs.org), so the App container's `npm install` works with
# no proxy configuration needed.

# Verbose logging: when an install fails on the App container, this
# is the only signal we get — per-package fetch progress dumps to the
# platform logs. Without it, "Exit handler never called!" looks like
# OOM but is usually the proxy-URL ETIMEDOUT issue.
loglevel=verbose
